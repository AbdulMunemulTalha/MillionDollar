# --- Supabase (project: MillionDollar) ---
NEXT_PUBLIC_SUPABASE_URL=https://xqcqucpcyqnkscipndgd.supabase.co
# Server-only. Dashboard > Project Settings > API > service_role secret.
# Bypasses RLS — NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Polar ---
# Organization access token. Create one in the Polar dashboard.
POLAR_ACCESS_TOKEN=
# "sandbox" (default, no real charges) or "production".
POLAR_SERVER=sandbox
# Polar organization id (optional when the token is already org-scoped).
POLAR_ORGANIZATION_ID=252ff012-df69-41b6-867b-500eda5671e9
# Product id printed by `npm run setup:polar`.
POLAR_PRODUCT_ID=
# Webhook signing secret. Polar dashboard > Settings > Webhooks.
POLAR_WEBHOOK_SECRET=

# --- App ---
# Absolute base URL, used to build Polar success/redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
